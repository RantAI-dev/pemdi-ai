# Environment for the RantAI Lakehouse stack that backs Pemdi-AI.
# Copy to infra/lakehouse.env (gitignored) and fill in the blanks.
# Used by scripts/lakehouse.sh; the lakehouse repo itself is not modified.

# First admin account. The lakehouse forces a password change on first
# login; scripts/lakehouse-bootstrap.sh does that and writes the result
# to .env.local for the app.
AUTH_BOOTSTRAP_EMAIL=admin@pemdi.local
AUTH_BOOTSTRAP_PASSWORD=

APP_ENV=local

# Uploads: file store credentials (local throwaway stack reuses RustFS root).
UPLOAD_S3_ACCESS_KEY=rustfsadmin
UPLOAD_S3_SECRET_KEY=rustfsadmin

# Uploads are loaded by Dagster's file_ingest_job.
DAGSTER_URL=http://dagster-webserver:3000/graphql
DAGSTER_WEBSERVER_HOST_PORT=127.0.0.1:3001
# Lakekeeper reports this as its own address; the ingest job runs inside
# the compose network, so it must be the in-network name.
LAKEKEEPER_BASE_URI=http://lakekeeper:8181

# NL2SQL / AI copilot: any OpenAI-compatible endpoint.
LLM_URL=https://api.minimax.io/v1
LLM_MODEL=MiniMax-M3
LLM_KEY=
AI_DEFAULT_REPLY_LANGUAGE=id

# Host ports, bound to this machine only. The backing services use default
# credentials (Postgres, RustFS) or none (ClickHouse), so they are not
# published to the network; only the Pemdi-AI app (port 3100) is.
API_HOST_PORT=127.0.0.1:8080
POSTGRES_HOST_PORT=127.0.0.1:5432
CH_HTTP_HOST_PORT=127.0.0.1:8123
CH_NATIVE_HOST_PORT=127.0.0.1:9000
RUSTFS_HOST_PORT=127.0.0.1:9010
RUSTFS_CONSOLE_HOST_PORT=127.0.0.1:9011
LAKEKEEPER_HOST_PORT=127.0.0.1:8181
